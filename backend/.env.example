# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# The system boots and runs without any of these:
#   - no SARVAM key  -> voice input/output disabled, text input still works
#   - no LLM key     -> retrieval still runs, answers degrade to extractive
# So you can build and test the pipeline before keys arrive.

# ---------------- Speech (Sarvam) ----------------
# https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ---------------- Generation (failover chain) ----------------
# Tried in GENERATION_PROVIDER_ORDER; first healthy one wins.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------- Qdrant ----------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_xi

# ---------------- Runtime ----------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------------- Ingest sizing ----------------
# Main lever on index size and ingest time. Raise once VM RAM is known.
MAX_QUERIES_PER_LANGUAGE=20000
CHUNKING_STRATEGY=parent_child

# ---------------- Rate limiting (protects your API credits) ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500
GLOBAL_DAILY_CAP=5000

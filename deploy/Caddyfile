# Reverse proxy: one public hostname, both services behind it.
#
# Served over HTTPS because voice input requires it — browsers block
# getUserMedia on insecure origins, so the microphone is dead on plain HTTP no
# matter what the app does.
#
# sslip.io resolves any IP-shaped hostname to that IP, so this works with no
# registrar and no DNS record: 140-238-224-158.sslip.io already points here,
# and Caddy provisions a Let's Encrypt certificate for it on first start.
#
# To move to a real domain later, replace the hostname below and point its A
# record at this host. Nothing else changes.

140-238-224-158.sslip.io {
	# API first — more specific path wins regardless of block order, but
	# keeping it first reads in request order.
	handle /api/* {
		reverse_proxy api:8000 {
			# Model loading on a cold first request can take ~30s; the
			# default 30s dial timeout would cut it off mid-flight.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
		level INFO
	}
}

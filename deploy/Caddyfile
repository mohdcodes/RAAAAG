# Reverse proxy: one public port, both services behind it.
#
# Serving on :80 by the IP, which is what the deployment currently targets.
#
# IMPORTANT — voice input needs HTTPS. Browsers block getUserMedia on insecure
# origins (localhost excepted), so on plain HTTP the microphone button will not
# work; text queries and TTS playback still do. To enable voice, point a domain
# at this host and replace the `:80` line below with the bare domain name —
# Caddy then provisions a Let's Encrypt certificate automatically, with no
# other change required:
#
#     rag.example.com {
#         ...same body...
#     }
#
# A free option that needs no registrar: sslip.io resolves any IP-shaped
# hostname, so `140-238-224-158.sslip.io` points here already and Caddy can
# certificate it.

:80 {
	# API first — more specific path wins regardless of block order, but
	# keeping it first reads in request order.
	handle /api/* {
		reverse_proxy api:8000 {
			# Model loading on a cold first request can take ~30s; the
			# default 30s dial timeout would cut it off mid-flight.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Caddy sends this by default on TLS sites; suppress it on plain
		# HTTP where it would pin browsers to a scheme that is not served.
		-Strict-Transport-Security
	}

	log {
		output stdout
		format console
		level INFO
	}
}

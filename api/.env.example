# Copy to `api/.env` and fill in. `api/.env` is gitignored — never commit real keys.
#
# NOTHING built so far needs a key: build_corpus.py, build_index.py, chunking,
# embedding and FAISS retrieval all run fully offline. Keys are only needed
# once generation (Gemini) and voice (ElevenLabs) are wired in.

# --- REQUIRED for answer generation -------------------------------------
# Free tier is enough for this project. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- OPTIONAL: override model choice ------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- REQUIRED for voice (frontend proxies these; backend does not use them) --
# Set these in web/.env.local, NOT here. Listed for reference only.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- OPTIONAL: faster/authenticated HuggingFace downloads ----------------
# HF_TOKEN=

# --- OPTIONAL: tuning ---------------------------------------------------
# LOG_LEVEL=INFO
# INDEX_TYPE=flat
# OMP_THREADS=4
